@{
    ViewData["Title"] ??= "Ask EduBot";
}

@section HeadContent {
    <link rel="preconnect" href="https://cdn.botpress.cloud" />
    <script src="https://cdn.botpress.cloud/webchat/v3.3/inject.js"></script>
    <script src="https://files.bpcontent.cloud/2025/10/18/22/20251018221400-MOUTK20P.js" defer></script>
}

<section class="card">
    <h1 class="h1">Ask EduBot</h1>
    <p class="subtitle">This assistant answers questions about our enrollment dataset.</p>
    <p>Chat below. The widget is embedded directly in this page.</p>
</section>

<section class="card chat-card">
    <div id="bp-embedded-webchat"></div>
</section>

<noscript>
    <p>Chat requires JavaScript. Please enable it to use EduBot.</p>
</noscript>

﻿
